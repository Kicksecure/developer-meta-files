#!/bin/bash

## Copyright (C) 2026 - 2026 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## No 'set -x': xtrace prints every command's EXPANDED form to the terminal,
## which would echo an untrusted ref name (git permits U+202E and other spoofing
## codepoints in ref names) RAW, before any scan or stcat neutralization runs.
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

true "INFO: Currently running script: ${BASH_SOURCE[0]} $*"

# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/has.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.bsh
# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/log_run_die.sh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/log_run_die.sh

has stcat || die 1 "'stcat' not on PATH."
has unicode-show || die 1 "'unicode-show' not on PATH."

if [ "$#" -lt 1 ]; then
   die 2 "usage: ${0##*/} [git-diff-option...] <ref-or-range>"
fi

## The FINAL argument is the ref or revision range to review; anything before it
## is forwarded verbatim to the review tools (and thus to 'git diff'), e.g. -C /
## --find-copies so a rename shows as a diff instead of a delete plus an add.
review_spec="${!#}"
review_opts=( "${@:1:$#-1}" )

if [[ "${review_spec}" == -* ]]; then
   die 2 "ref '${review_spec}' must not start with '-' (git-diff options go before the ref)."
fi

## A bare '--' would forward to 'git diff' as the pathspec separator, turning the
## ref into a pathspec: an empty, silently-successful review. It is never a valid
## diff option here (the ref is the final argument), so reject it.
for review_opt in "${review_opts[@]}"; do
   if [ "${review_opt}" = '--' ]; then
      die 2 "'--' is not a valid option here; the ref/range is the final argument."
   fi
done

## Accept a full revision range (base...target or base..target) as well as a bare
## ref (reviewed against HEAD, the historical default). Split on the FIRST '...'
## or '..' -- correct for the ref/range forms this tool takes (branch names, tags,
## SHAs, remote/branch). An exotic revision whose text embeds '..' (git's
## '^{/regex}' commit search or ':/text') is unsupported: it fails to resolve
## loudly rather than being mis-split silently.
if [[ "${review_spec}" == *...* ]]; then
   range_op='...'
   range_base="${review_spec%%...*}"
   range_target="${review_spec#*...}"
elif [[ "${review_spec}" == *..* ]]; then
   range_op='..'
   range_base="${review_spec%%..*}"
   range_target="${review_spec#*..}"
else
   range_op=''
   range_base=''
   range_target="${review_spec}"
fi
if [ -z "${range_target}" ]; then
   die 2 "ref/range '${review_spec}' has no target ref."
fi

## Resolve every side to an IMMUTABLE commit up front, so a concurrent fetch that
## moves a ref mid-review cannot make a later step act on commits the scan never
## saw.
if ! target_commit="$(git rev-parse --verify --end-of-options "${range_target}^{commit}" 2>/dev/null)"; then
   die 2 "ref '${range_target}' does not resolve to a commit."
fi
if [ -n "${range_base}" ]; then
   if ! base_commit="$(git rev-parse --verify --end-of-options "${range_base}^{commit}" 2>/dev/null)"; then
      die 2 "base ref '${range_base}' does not resolve to a commit."
   fi
   review_range="${base_commit}${range_op}${target_commit}"
   ## Scan the commits introduced relative to the explicit base.
   scan_base_arg=( "${base_commit}" )
else
   ## Bare ref (or an empty-base range like '...feature'): review against HEAD. A
   ## bare ref keeps the three-dot form; an empty-base range keeps the operator
   ## the user typed. The scan uses HEAD as its base (single argument).
   review_range="${range_op:-...}${target_commit}"
   scan_base_arg=()
fi

## Handle the result of a unicode-spoofing scan ($1 = its exit code, $2 = its
## name). The scan tools separate their exit codes on purpose:
##   0    = clean;
##   1    = a look-alike was found;
##   >= 2 = the scan could not run (bad/absent ref, no new commits, not a work
##          tree, git failure).
## prompt rc: 0 = continue; 1 = declined; 2 = no controlling terminal to ask (a
## CI/batch run) -> fail closed.
review_prompt_or_die() {
   local scan_rc="$1" scan_name="$2" prompt_rc
   if [ "${scan_rc}" -eq 0 ]; then
      return 0
   fi
   if [ "${scan_rc}" -ge 2 ]; then
      die "${scan_rc}" "'${scan_name}' could not run (rc='${scan_rc}'); see its error above. Failing closed."
   fi
   log warn "'${scan_name}' flagged possible unicode spoofing (rc='${scan_rc}')."
   prompt_rc=0
   prompt_yes_no_tty "Continue the review anyway?" || prompt_rc="$?"
   if [ "${prompt_rc}" -eq 2 ]; then
      die "${scan_rc}" "'${scan_name}' flagged spoofing and there is no terminal to ask; failing closed."
   fi
   if [ "${prompt_rc}" -ne 0 ]; then
      die "${scan_rc}" "aborting the review at your request."
   fi
   log info "continuing despite '${scan_name}' (rc='${scan_rc}')."
}

## Scan the ref's new commits (content, messages, author identity)...
scan_rc=0
check-ref-commits-for-unicode "${target_commit}" "${scan_base_arg[@]}" || scan_rc="$?"
review_prompt_or_die "${scan_rc}" check-ref-commits-for-unicode

## ...and every ref NAME in the repo, for spoofing via non-ASCII unicode.
## check-ref-names-for-unicode takes ref-name GLOBS (git for-each-ref), not a
## single ref -- with no argument it scans all refs (its documented default).
## Passing the reviewed ref instead would only check that one name (missing a
## spoofed sibling), and a look-alike name would make for-each-ref fail to
## match ("No refs matched") rather than be flagged as suspicious. Scanning
## every ref catches a spoofed name anywhere the fetch introduced one.
scan_rc=0
check-ref-names-for-unicode || scan_rc="$?"
review_prompt_or_die "${scan_rc}" check-ref-names-for-unicode

git --no-pager log "${review_range}" | NO_COLOR=1 stcat

git-diff-review "${review_opts[@]}" "${review_range}"

git-meld "${review_opts[@]}" "${review_range}"

git-kdiff3 "${review_opts[@]}" "${review_range}"

true "$0: OK."
